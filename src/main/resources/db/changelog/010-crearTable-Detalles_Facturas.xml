<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet id="10" author="leo">
        <createTable tableName="detalles_facturas">
            <column name="id_detalle_factura" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="id_factura" type="int">
                <constraints nullable="false"
                                foreignKeyName="fk_detalle_factura_factura"
                                references="facturas(id_factura)"/>
            </column>
            <column name="id_concepto" type="int">
                <constraints nullable="false"
                                foreignKeyName="fk_detalle_factura_concepto"
                                references="conceptos(id_concepto)"/>
            </column>
            <column name="subtotal" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="cantidad" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="creacion" type="datetime">
                <constraints nullable="false"/>
            </column>

            <column name="actualizacion" type="datetime">
                <constraints nullable="false"/>
            </column>

            <column name="activo" type="boolean">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
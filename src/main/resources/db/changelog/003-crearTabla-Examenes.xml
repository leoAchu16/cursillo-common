<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet id="3" author="leo">
        <createTable tableName="examenes">
            <column name="id_examen" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="id_materia" type="int">
                <constraints nullable="false"
                             foreignKeyName="fk_examen_materia"
                             references="materias(id_materia)"/>
            </column>
            <column name="id_profesor" type="int">
                <constraints nullable="false" foreignKeyName="fk_examen_profesor" references="usuarios(id_usuario)"/>
            </column>
            <column name="hora" type="time">
                <constraints nullable="false"/>
            </column>
            <column name="fecha" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="titulo" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="total_puntos" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="creacion" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="actualizacion" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="activo" type="boolean">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
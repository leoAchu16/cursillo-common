
<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet id="usuario-roles-quitar-auditoria" author="tu-nombre">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="usuario_roles" columnName="creacion"/>
        </preConditions>
        <dropColumn tableName="usuario_roles" columnName="creacion"/>
        <dropColumn tableName="usuario_roles" columnName="actualizacion"/>
        <dropColumn tableName="usuario_roles" columnName="activo"/>
    </changeSet>
</databaseChangeLog>
<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet id="5" author="leo">
        <createTable tableName="inscripciones">
            <column name="id_inscripcion" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="id_alumno" type="int">
                <constraints nullable="false"
                             foreignKeyName="fk_inscripcion_alumno"
                             references="usuarios(id_usuario)"/>
            </column>
            <column name="id_secretaria" type="int">
                <constraints nullable="false"
                             foreignKeyName="fk_inscripcion_secretaria"
                             references="usuarios(id_usuario)"/>
            </column>
            <column name="fecha_inscripcion" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="total" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="estado_pago" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="creacion" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="actualizacion" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="activo" type="boolean">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
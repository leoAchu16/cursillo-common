<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet id="6" author="leo">
        <createTable tableName="detalles_inscripcion">
            <column name="id_detalle_inscripcion" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="id_inscripcion" type="int">
                <constraints nullable="false"
                             foreignKeyName="fk_detalle_inscripcion_inscripcion"
                             references="inscripciones(id_inscripcion"/>
            </column>
            <column name="id_materia" type="int">
                <constraints nullable="true"
                             foreignKeyName="fk_detalle_inscripcion_materia"
                             references="materias(id_materia)"/>
            </column>
            <column name="id_examen" type="int">
                <constraints nullable="true"
                             foreignKeyName="fk_detalle_inscripcion_examen"
                             references="examenes(id_examen)"/>
            </column>
            <column name="tipo_inscripcion" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="costo" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="creacion" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="actualizacion" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="activo" type="boolean">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">


    <changeSet id="9" author="sebastianLB16">
        <createTable tableName="conceptos">
            <column name="id_concepto" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="nombre" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="monto_base" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="creacion" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="actualizacion" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="activo" type="boolean">
                <constraints nullable="false"/>
            </column>



        </createTable>
    </changeSet>
</databaseChangeLog>
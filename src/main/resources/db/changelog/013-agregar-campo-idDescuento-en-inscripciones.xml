<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet id="13" author="leo">
        <addColumn tableName="inscripciones">
            <column name="id_descuento" type="int"/>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="inscripciones"
                baseColumnNames="id_descuento"
                constraintName="fk_inscripcion_descuento"
                referencedTableName="descuentos"
                referencedColumnNames="id_descuento"/>
    </changeSet>
</databaseChangeLog>
<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog 
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet id="7" author="leo">
        <createTable tableName="materias">
            <column name="id_materia" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="id_profesor" type="int">
                <constraints nullable="false"
                             foreignKeyName="fk_materia_profesor"
                             references="usuarios(id_usuario)"/>
            </column>
            <column name="nombre_materia" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="dia" type="varchar(10)">
                <constraints nullable="false"/>
            </column>
            <column name="descripcion" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="creacion" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="actualizacion" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="activo" type="boolean">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
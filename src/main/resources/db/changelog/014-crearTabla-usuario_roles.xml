<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet id="14" author="leo">
        <createTable tableName="usuario_roles">
            <column name="id_usuario" type="INT" autoIncrement="true">
                <constraints nullable="false"
                    foreignKeyName="fk_usuario_roles_usuario"
                    references="usuarios(id_usuario)"/>
            </column>
            <column name="rol" type="varchar(30)">
                <constraints nullable="false"/>
            </column>
            <column name="creacion" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="actualizacion" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="activo" type="boolean">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="usuario_roles"
                       columnNames="id_usuario, rol"
                       constraintName="pk_usuario_roles"/>
    </changeSet>
</databaseChangeLog>
